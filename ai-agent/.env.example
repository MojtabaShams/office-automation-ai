# ------------------------------------------------------------------ application
APP_NAME=Office Automation AI Agent
ENVIRONMENT=development
DEBUG=false

# --------------------------------------------------------------------- database
# SQLAlchemy URL; the app normalises postgres:// and postgresql:// automatically.
DATABASE_URL=postgresql://admin:adminpass@localhost:5432/office_automation
DB_ECHO=false
AUTO_RUN_MIGRATIONS=true

# ------------------------------------------------------------------------- auth
# Short-lived access tokens; the admin/client session ends 30 minutes after login.
AUTH_TOKEN_TTL_MINUTES=30
AUTH_MAX_SESSIONS_PER_USER=10

# Login / register throttling (in-process sliding window per client + identifier).
AUTH_LOGIN_RATE_LIMIT=8
AUTH_LOGIN_RATE_WINDOW_SECONDS=60
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REGISTER_RATE_WINDOW_SECONDS=300

# Optional bootstrap admin (created/updated on startup when SEED_ON_STARTUP=true)
ADMIN_MOBILE=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=مدیر سامانه

# ---------------------------------------------------------------- payment gateways
# Minimum length of a gateway connection key (never returned by the API).
PAYMENT_GATEWAY_KEY_MIN_LENGTH=8

# ------------------------------------------------------------------------ agent
# Multi-model ensemble through GapGPT (OpenAI-compatible endpoint).
# Fill GAPGPT_API_KEY only from the local environment / secret store — never commit it.
# Leave it empty to keep the deterministic fallback (no LLM calls).
GAPGPT_API_KEY=
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
# One committee member per vendor; every model id is routed through GapGPT.
GAPGPT_MODEL_GEMINI=gemini-2.5-flash
GAPGPT_MODEL_CHATGPT=gpt-4o-mini
GAPGPT_MODEL_CLAUDE=claude-sonnet-4
# The judge compares the three answers and synthesises the final reply.
# Leave GAPGPT_MODEL_JUDGE empty to use GAPGPT_MODEL_CLAUDE.
GAPGPT_MODEL_JUDGE=
AGENT_ENSEMBLE_ENABLED=true
AGENT_ENSEMBLE_JUDGE_ENABLED=true
AGENT_ENSEMBLE_TIMEOUT_SECONDS=28
AGENT_ENSEMBLE_TEMPERATURE=0.2
AGENT_ENSEMBLE_MAX_TOKENS=1200
# Skip the judge round-trip when one model already wins clearly.
AGENT_ENSEMBLE_EARLY_STOP=true
AGENTSCOPETEAM_ENABLED=true

# Legacy single-model fallback, used only when GAPGPT_API_KEY is empty.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=1200
# Optional standard OpenAI or OpenAI-compatible provider (used when Groq is not configured).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AGENT_MAX_TOOL_ITERATIONS=4

# ------------------------------------------------------------------- embeddings
# "hashing" works fully offline (deterministic 384-dim vectors);
# "openai" calls any OpenAI-compatible /embeddings endpoint.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=

# ---------------------------------------------------------------------- content
# Defaults point at ai-agent/forms and ai-agent/knowledge; only set these to override.
# FORMS_DIR=/app/forms
# KNOWLEDGE_DIR=/app/knowledge
SEED_ON_STARTUP=true
KNOWLEDGE_CHUNK_SIZE=800
KNOWLEDGE_CHUNK_OVERLAP=120
KNOWLEDGE_TOP_K=4
KNOWLEDGE_MIN_SCORE=0.05

# ------------------------------------------------------------------------- chat
CHAT_HISTORY_LIMIT=20
CHAT_SUMMARY_TRIGGER=16
MAX_MESSAGE_CHARS=4000

# ------------------------------------------------------------------------- http
# Only the admin (3000) and client (3002) apps may call the API from a browser.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002
